# ───────────── Required ─────────────
# GitHub Personal Access Token (repo scope, write for PRs)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signature secret (REQUIRED in production)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ───────────── Optional ─────────────
# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Slack webhook for alerts
SLACK_WEBHOOK=https://hooks.slack.com/services/xxxxx

# Health/metrics/webhook server port (default: 8080)
HEALTH_PORT=8080

# Config file path (default: mantior.yaml)
# MANTIOR_CONFIG=./mantior.yaml

# OpenTelemetry tracing (Phase 2; false keeps the stub seam)
ENABLE_TRACING=false

# OpenAI API key for the LLM fixer fallback
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model override (default: gpt-4-turbo-preview)
# OPENAI_MODEL=gpt-4o-mini
